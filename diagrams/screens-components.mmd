%% Raíz: `src/`
%% - src/
%%   - components/           # Componentes reutilizables por dominio
%%     - Navbar/
%%       - Navbar.tsx
%%       - Navbar.styles.ts
%%     - TaskList/
%%       - TaskList.tsx
%%       - TaskCard.tsx
%%     - TaskForm/
%%       - TaskForm.tsx
%%       - TaskForm.types.ts
%%     - PriorityModal/
%%       - PriorityModal.tsx
%%     - FiltersBar/
%%       - FiltersBar.tsx
%%     - AIIndicator/
%%       - AIIndicator.tsx
%%     - UI/                 # botones, chips, badges, snackbar wrappers
%%   - pages/
%%     - Home.tsx
%%     - TaskDetails.tsx
%%   - context/
%%     - AppProvider.tsx     # contexto global + proveedor
%%     - TaskContext.ts      # hooks/consumidores específicos
%%   - hooks/
%%     - useTasks.ts         # lógica de tareas (fetch, sync, optimistic)
%%     - useAI.ts            # llamada a IA y cache de sugerencias
%%     - useUI.ts            # estado UI local (modals, snackbars)
%%   - services/
%%     - api.ts              # llamadas a backend (REST/fetch)
%%     - aiService.ts        # wrapper para endpoint IA
%%   - types/
